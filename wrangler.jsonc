{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bento-system",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bento_db",
      "database_id": "bento_db"
    }
  ]
}
