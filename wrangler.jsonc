{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bento-system",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bento_db"
      // ⚠️ 不要寫 database_id！讓 Cloudflare 一鍵部署時自動配發並綁定
    }
  ]
}
